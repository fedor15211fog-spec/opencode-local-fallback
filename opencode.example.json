{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false
  },
  "providers": {
    "localqwen": {
      "name": "Local Qwen (LM Studio)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1236/v1",
        "apiKey": "local-shim"
      },
      "models": {
        "qwen2.5-coder-7b-instruct": {
          "name": "Qwen2.5 Coder 7B (local)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
